# ─── MomayBUU server (server.js) ───
# ตั้งค่าเหล่านี้เป็น Environment Variables บน Railway (ห้าม commit ค่าจริงลง git)
PORT=8000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# ต้องตรงกับ RELAY_KEY ของ cctv/relay.py — ถ้าไม่ตั้ง server จะปฏิเสธ relay ทุกตัว
RELAY_KEY=your-long-random-secret

# (optional) URL ของ Control server สำหรับ Sonoff
# CONTROL_URL=https://controlbuu-production.up.railway.app

# (optional) ชื่อฐานข้อมูล MongoDB (ค่าเริ่มต้น momay_buu)
# DB_NAME=momay_buu

# (optional) ถ้าตั้งไว้ เครื่องสแกน QR ที่ประตูต้องส่ง header X-Scanner-Key: <ค่านี้> มากับ POST /api/verify
# SCANNER_KEY=another-long-random-secret

# (optional) URL สาธารณะของแอพ ใช้สร้างลิงก์เชิญสมาชิก (ไม่ต้องเชื่อ Host header)
# PUBLIC_URL=https://momaybuu-production.up.railway.app

# หมายเหตุ: script.js, style.css ฯลฯ ใน index.html โหลดแบบ ?v=<เวอร์ชัน> และ browser จะ cache ไว้ 1 ปี
# ทุกครั้งที่แก้ไฟล์เหล่านี้ ต้องเปลี่ยนเลข ?v= ใน index.html และ sw.js ด้วย
